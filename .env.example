# Copy to .env in the project root and fill in. Never commit .env.
# Every setting is documented in app/settings.py and the README.

# --- AI Foundry (signature and date reading) -----------------------------
LLM_BASE_URL=https://url-to-foundry
LLM_CHAT_PATH=/foundry/chat/completions
LLM_MODEL=gpt-6-luna
# Sent as the X-PBAI-Helper-Id header; blank = not sent.
HELPER_ID=
# gpt-6-luna's hidden reasoning counts against this; raise to 8000 if replies come back cut off.
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=120
# false matches the other internal projects (company CA not in Python's trust list).
LLM_VERIFY_SSL=false
LLM_MAX_ATTEMPTS=3

# --- Signature crop: the only part of the cheque sent for the signature check
# Check signature/annotated.png on real scans; keep the zone to the signing area.
SIGNATURE_ZONE_LEFT_FRACTION=0.30
SIGNATURE_ZONE_TOP_FRACTION=0.55
SIGNATURE_ZONE_BOTTOM_FRACTION=0.87

# --- PaddleOCR models (used only to locate the TARIKH/DATE labels) --------
OCR_MODELS_DIR=../FileReader/models

# --- Behaviour ---------------------------------------------------------------
SAVE_ARTIFACTS=true
# Workers now mostly wait on AI Foundry: raise gradually, lower if you see HTTP 429.
WORKER_COUNT=1
THREADS_PER_WORKER=1
